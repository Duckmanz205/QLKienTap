# Cấu hình bảo mật API nội bộ
GRADING_API_KEY=satori_2026_secure_key

# Cấu hình Deploy API (portal.deploy) - Dùng chung 1 model & 1 API key cho cả OCR và Chấm điểm
DEPLOY_API_KEY=... (ĐIỀN KEY DEPLOY CỦA BẠN VÀO ĐÂY)
DEPLOY_BASE_URL=https://api-cdn.deploy.com/api/v1
DEPLOY_MODEL=deepseek-ai/deepseek-v4.1-flash-1017

# Cấu hình suy luận (none | low | high | max) & điều tiết luồng cho API key dùng chung
OCR_REASONING_EFFORT=none
GRADING_REASONING_EFFORT=none
AI_MAX_CONCURRENT_REQUESTS=3
OCR_MAX_CONCURRENT_PAGES=2
